import smbus2
import time
import numpy as np
from dataclasses import dataclass
from enum import Enum

# ============================================================================
# CONFIGURATION
# ============================================================================

# Tilt thresholds for triggering movement
TILT_THRESHOLD = 15.0          # Degrees - minimum tilt to trigger movement
TILT_NEUTRAL_ZONE = 5.0        # Degrees - deadzone around neutral

# Servo configuration
SERVO_STEP_SIZE = 5            # Degrees to move servo per trigger
SERVO_MOVE_DELAY = 0.2         # Seconds between moves (prevents rapid fire)

# Servo limits (adjust for your servos)
SERVO_LIMITS = {
    'base': (0, 180),          # Base rotation (left/right)
    'shoulder': (0, 180),      # Shoulder (forward/back)
    'elbow': (0, 180)          # Elbow (up/down)
}

# Update rate
UPDATE_RATE_HZ = 20

# ============================================================================
# DIRECTION ENUM
# ============================================================================

class TiltDirection(Enum):
    NEUTRAL = 0
    LEFT = 1
    RIGHT = 2
    FORWARD = 3
    BACK = 4
    UP = 5
    DOWN = 6

# ============================================================================
# SERVO POSITIONS
# ============================================================================

@dataclass
class ServoPositions:
    """Current servo angles"""
    base: float = 90.0       # Left/right rotation
    shoulder: float = 90.0   # Forward/back
    elbow: float = 90.0      # Up/down
    
    def __str__(self):
        return f"Servos(Base={self.base:.0f}°, Shoulder={self.shoulder:.0f}°, Elbow={self.elbow:.0f}°)"

# ============================================================================
# MPU6050 INTERFACE (simplified from your code)
# ============================================================================

class MPU6050:
    """MPU6050 IMU interface"""
    
    PWR_MGMT_1 = 0x6B
    ACCEL_XOUT_H = 0x3B
    GYRO_XOUT_H = 0x43
    ACCEL_SCALE = 16384.0
    GYRO_SCALE = 131.0
    
    def __init__(self, bus_num=1, address=0x68):
        self.bus = smbus2.SMBus(bus_num)
        self.address = address
        self._initialize()
    
    def _initialize(self):
        self.bus.write_byte_data(self.address, self.PWR_MGMT_1, 0)
        time.sleep(0.1)
    
    def read_raw_data(self, reg):
        high = self.bus.read_byte_data(self.address, reg)
        low = self.bus.read_byte_data(self.address, reg + 1)
        value = (high << 8) | low
        if value > 32768:
            value -= 65536
        return value
    
    def read_accel(self):
        ax = self.read_raw_data(self.ACCEL_XOUT_H) / self.ACCEL_SCALE
        ay = self.read_raw_data(self.ACCEL_XOUT_H + 2) / self.ACCEL_SCALE
        az = self.read_raw_data(self.ACCEL_XOUT_H + 4) / self.ACCEL_SCALE
        return ax, ay, az
    
    def read_gyro(self):
        gx = self.read_raw_data(self.GYRO_XOUT_H) / self.GYRO_SCALE
        gy = self.read_raw_data(self.GYRO_XOUT_H + 2) / self.GYRO_SCALE
        gz = self.read_raw_data(self.GYRO_XOUT_H + 4) / self.GYRO_SCALE
        return gx, gy, gz

# ============================================================================
# COMPLEMENTARY FILTER
# ============================================================================

class ComplementaryFilter:
    """Fuses accelerometer and gyroscope for stable tilt angles"""
    
    def __init__(self, alpha=0.96):
        self.alpha = alpha
        self.roll = 0.0
        self.pitch = 0.0
    
    def update(self, accel, gyro, dt):
        ax, ay, az = accel
        gx, gy, gz = gyro
        
        # Integrate gyroscope
        self.roll += gx * dt
        self.pitch += gy * dt
        
        # Calculate from accelerometer
        accel_roll = np.arctan2(ay, np.sqrt(ax**2 + az**2)) * 180 / np.pi
        accel_pitch = np.arctan2(-ax, np.sqrt(ay**2 + az**2)) * 180 / np.pi
        
        # Complementary filter
        self.roll = self.alpha * self.roll + (1 - self.alpha) * accel_roll
        self.pitch = self.alpha * self.pitch + (1 - self.alpha) * accel_pitch
        
        return self.roll, self.pitch

# ============================================================================
# TILT-TO-SERVO CONTROLLER
# ============================================================================

class TiltServoController:
    """Maps IMU tilt to discrete servo movements"""
    
    def __init__(self,
                 tilt_threshold=TILT_THRESHOLD,
                 neutral_zone=TILT_NEUTRAL_ZONE,
                 servo_step=SERVO_STEP_SIZE,
                 move_delay=SERVO_MOVE_DELAY):
        
        self.tilt_threshold = tilt_threshold
        self.neutral_zone = neutral_zone
        self.servo_step = servo_step
        self.move_delay = move_delay
        
        # Current servo positions
        self.servos = ServoPositions()
        
        # Calibration offsets
        self.roll_offset = 0.0
        self.pitch_offset = 0.0
        self.is_calibrated = False
        
        # Movement timing (prevent rapid fire)
        self.last_move_time = 0.0
        self.last_direction = TiltDirection.NEUTRAL
    
    def calibrate(self, roll: float, pitch: float):
        """Set current tilt as neutral position"""
        self.roll_offset = roll
        self.pitch_offset = pitch
        self.is_calibrated = True
        print(f"✓ Calibrated! Neutral: Roll={roll:.1f}°, Pitch={pitch:.1f}°")
    
    def detect_direction(self, roll: float, pitch: float) -> TiltDirection:
        """Detect which direction is tilted based on thresholds"""
        
        if not self.is_calibrated:
            return TiltDirection.NEUTRAL
        
        # Remove calibration offset
        roll_rel = roll - self.roll_offset
        pitch_rel = pitch - self.pitch_offset
        
        # Check if within neutral zone
        if abs(roll_rel) < self.neutral_zone and abs(pitch_rel) < self.neutral_zone:
            return TiltDirection.NEUTRAL
        
        # Determine primary direction (largest tilt magnitude)
        # This prevents diagonal confusion
        
        if abs(roll_rel) > abs(pitch_rel):
            # Roll is dominant (left/right)
            if roll_rel > self.tilt_threshold:
                return TiltDirection.RIGHT
            elif roll_rel < -self.tilt_threshold:
                return TiltDirection.LEFT
        else:
            # Pitch is dominant (forward/back)
            if pitch_rel > self.tilt_threshold:
                return TiltDirection.BACK
            elif pitch_rel < -self.tilt_threshold:
                return TiltDirection.FORWARD
        
        return TiltDirection.NEUTRAL
    
    def clamp_servo(self, angle: float, servo_name: str) -> float:
        """Clamp servo angle to limits"""
        min_angle, max_angle = SERVO_LIMITS[servo_name]
        return np.clip(angle, min_angle, max_angle)
    
    def move_servo(self, direction: TiltDirection) -> bool:
        """Move servos based on detected direction"""
        
        # Check if enough time has passed since last move
        current_time = time.time()
        if current_time - self.last_move_time < self.move_delay:
            return False
        
        # Don't move if neutral or same direction held
        if direction == TiltDirection.NEUTRAL:
            self.last_direction = TiltDirection.NEUTRAL
            return False
        
        # Track movement
        moved = False
        
        # Map directions to servo movements
        if direction == TiltDirection.LEFT:
            self.servos.base -= self.servo_step
            self.servos.base = self.clamp_servo(self.servos.base, 'base')
            moved = True
            print(f"  ← LEFT - Base: {self.servos.base:.0f}°")
        
        elif direction == TiltDirection.RIGHT:
            self.servos.base += self.servo_step
            self.servos.base = self.clamp_servo(self.servos.base, 'base')
            moved = True
            print(f"  → RIGHT - Base: {self.servos.base:.0f}°")
        
        elif direction == TiltDirection.FORWARD:
            self.servos.shoulder += self.servo_step
            self.servos.shoulder = self.clamp_servo(self.servos.shoulder, 'shoulder')
            moved = True
            print(f"  ↑ FORWARD - Shoulder: {self.servos.shoulder:.0f}°")
        
        elif direction == TiltDirection.BACK:
            self.servos.shoulder -= self.servo_step
            self.servos.shoulder = self.clamp_servo(self.servos.shoulder, 'shoulder')
            moved = True
            print(f"  ↓ BACK - Shoulder: {self.servos.shoulder:.0f}°")
        
        # Update timing
        if moved:
            self.last_move_time = current_time
            self.last_direction = direction
        
        return moved
    
    def update(self, roll: float, pitch: float) -> tuple:
        """Main update: detect tilt and move servos"""
        
        # Detect direction
        direction = self.detect_direction(roll, pitch)
        
        # Move servo if triggered
        self.move_servo(direction)
        
        return direction, self.servos


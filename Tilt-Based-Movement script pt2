# ============================================================================
# MAIN CONTROL LOOP
# ============================================================================

def main():
    print("=" * 70)
    print("IMU Tilt-Based Servo Controller")
    print("=" * 70)
    print()
    print("Control Mode: Tilt IMU to move servos")
    print("  - Tilt LEFT → Base servo rotates left")
    print("  - Tilt RIGHT → Base servo rotates right")
    print("  - Tilt FORWARD → Shoulder servo moves forward")
    print("  - Tilt BACK → Shoulder servo moves back")
    print()
    print(f"Tilt threshold: {TILT_THRESHOLD}°")
    print(f"Servo step size: {SERVO_STEP_SIZE}°")
    print(f"Move delay: {SERVO_MOVE_DELAY}s")
    print()
    
    # Initialize hardware
    try:
        mpu = MPU6050()
        print("✓ MPU6050 initialized")
    except Exception as e:
        print(f"✗ Failed to initialize MPU6050: {e}")
        return
    
    # Initialize servo driver
    servo_driver = ServoDriver()
    print("✓ Servo driver initialized")
    
    # Initialize filters and controller
    comp_filter = ComplementaryFilter(alpha=0.96)
    controller = TiltServoController(
        tilt_threshold=TILT_THRESHOLD,
        neutral_zone=TILT_NEUTRAL_ZONE,
        servo_step=SERVO_STEP_SIZE,
        move_delay=SERVO_MOVE_DELAY
    )
    
    # Calibration
    print()
    print("Calibration:")
    print("  Hold IMU in neutral position (flat/level)")
    input("  Press ENTER when ready...")
    
    print("  Calibrating... (hold still)")
    roll_sum = pitch_sum = 0.0
    samples = 50
    
    for i in range(samples):
        accel = mpu.read_accel()
        gyro = mpu.read_gyro()
        roll, pitch = comp_filter.update(accel, gyro, 0.01)
        roll_sum += roll
        pitch_sum += pitch
        time.sleep(0.01)
    
    controller.calibrate(roll_sum / samples, pitch_sum / samples)
    
    # Set servos to initial position
    servo_driver.set_servo_angle('base', controller.servos.base)
    servo_driver.set_servo_angle('shoulder', controller.servos.shoulder)
    servo_driver.set_servo_angle('elbow', controller.servos.elbow)
    
    print()
    print("Starting controller...")
    print("Tilt IMU to move servos. Press Ctrl+C to stop")
    print()
    
    # Main control loop
    last_time = time.time()
    dt = 1.0 / UPDATE_RATE_HZ
    
    try:
        while True:
            current_time = time.time()
            actual_dt = current_time - last_time
            last_time = current_time
            
            # Read sensors
            accel = mpu.read_accel()
            gyro = mpu.read_gyro()
            
            # Update tilt estimate
            roll, pitch = comp_filter.update(accel, gyro, actual_dt)
            
            # Update controller (detects direction and moves servos)
            direction, servos = controller.update(roll, pitch)
            
            # Send to actual servos if movement occurred
            if direction != TiltDirection.NEUTRAL:
                servo_driver.set_servo_angle('base', servos.base)
                servo_driver.set_servo_angle('shoulder', servos.shoulder)
                servo_driver.set_servo_angle('elbow', servos.elbow)
            
            # Display current state
            direction_arrow = {
                TiltDirection.NEUTRAL: "  ●  ",
                TiltDirection.LEFT: "  ←  ",
                TiltDirection.RIGHT: "  →  ",
                TiltDirection.FORWARD: "  ↑  ",
                TiltDirection.BACK: "  ↓  "
            }.get(direction, "  ?  ")
            
            print(f"Tilt: Roll={roll:+6.1f}° Pitch={pitch:+6.1f}° | "
                  f"Dir: {direction_arrow} | "
                  f"{servos}",
                  end='\r')
            
            # Sleep to maintain update rate
            time.sleep(dt)
            
    except KeyboardInterrupt:
        print("\n\nStopping...")
        print(f"Final servo positions: {controller.servos}")

